{
  "rewrites": [{ "source": "/((?!assets/|images/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://atlas-studio.org https://*.atlas-studio.org http://localhost:5173" }
    ]}
  ]
}
