# En-têtes appliqués par Cloudflare Workers (fichiers statiques).
# CSP : tout est servi par le site lui-même (scripts, styles, polices, images) ; seule exception,
# l'API Supabase d'Atlas Studio (contenu et formulaire). Les attributs style="" de React
# exigent style-src-attr 'unsafe-inline' ; aucun script en ligne n'est autorisé.
# frame-ancestors : la console Atlas Studio affiche l'aperçu du site dans un iframe.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://vgtmljfayiysuvrcmunt.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests; frame-ancestors 'self' https://atlas-studio.org https://*.atlas-studio.org http://localhost:5173

/assets/*
  Cache-Control: public, max-age=31536000, immutable
