# Backend Atlas Studio (projet Supabase partagé). Clé publique anon uniquement.
# Aucune autre clé ne doit figurer ici ni être exposée au navigateur.
VITE_ATLAS_SUPABASE_URL=https://vgtmljfayiysuvrcmunt.supabase.co
VITE_ATLAS_SUPABASE_ANON_KEY=

# Origines de la console autorisées à afficher l'aperçu en direct (séparées par des virgules)
VITE_CONSOLE_ORIGINS=https://atlas-studio.org,http://localhost:5173

# Fonction contrôlée qui reçoit les pièces jointes du formulaire.
# Tant qu'elle n'est pas déployée, le champ « pièces jointes » reste inactif.
# Voir supabase/README.md.
VITE_LEAD_UPLOAD_URL=

# Mesure d'audience sans cookie de l'hébergeur (Cloudflare Web Analytics).
VITE_CF_ANALYTICS_TOKEN=

# Point d'entrée optionnel pour les événements de la section 14 du cahier des charges.
# Vide : aucun événement n'est envoyé.
VITE_ANALYTICS_ENDPOINT=
